{
  "meshConfig": {
    "sources": [
      {
        "name": "CommerceSaaSGraphQl",
        "handler": {
          "graphql": {
            "endpoint": "https://na1-sandbox.api.commerce.adobe.com/<TENANT_ID>/graphql",
            "useGETForQueries": true,
            "operationHeaders": {
              "Content-Type": "application/json",
              "Magento-Environment-Id": "{context.headers['magento-environment-id']}",
              "Magento-Website-Code": "{context.headers['magento-website-code']}",
              "Magento-Store-View-Code": "{context.headers['magento-store-view-code']}",
              "Magento-Store-Code": "{context.headers['magento-store-code']}",
              "Magento-Customer-Group": "{context.headers['magento-customer-group']}",
              "x-api-key": "{context.headers['x-api-key']}",
              "Authorization": "{context.headers['Authorization']}"
            }
          }
        },
        "responseConfig": {
          "headers": ["X-Magento-Cache-Id"]
        }
      },
      {
        "name": "CommerceRest",
        "handler": {
          "JsonSchema": {
            "baseUrl": "https://na1-sandbox.api.commerce.adobe.com/<TENANT_ID>",
            "operationHeaders": {
              "Store": "{context.headers['magento-store-view-code']}",
              "authorization": "Bearer {context.headers['x-ims-auth-token']}"
            },
            "operations": [
              {
                "type": "Query",
                "field": "productData",
                "path": "/V1/products/{args.sku}",
                "method": "GET",
                "responseTypeName": "Response",
                "responseSchema": "./product-schema.json",
                "argTypeMap": {
                  "sku": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "Query",
                "field": "storeConfigs",
                "path": "/V1/store/storeConfigs",
                "method": "GET",
                "responseTypeName": "StoreConfig",
                "responseSchema": "./store-config-schema.json"
              }
            ]
          }
        }
      }
    ],
    "additionalResolvers": [
      "./additional-resolvers.js"
    ],
    "plugins": [
      {
        "hooks": {
          "beforeAll": {
            "composer": "./hooks.js#accsRestAuth",
            "blocking": true
          }
        }
      }
    ]
  }
} 
