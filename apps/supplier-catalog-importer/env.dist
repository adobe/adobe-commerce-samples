# Copy to .env; never commit populated credentials.
# Select a development workspace with `aio app use` first.
AIO_RUNTIME_NAMESPACE=
AIO_RUNTIME_AUTH=
DB_REGION=amer

# The local bridge and deploy hook use these values.
# Runtime actions use include-ims-credentials from the selected workspace instead.
# Both must refer to the SAME Developer Console workspace.
# Standard IMS_OAUTH_S2S_* and AIO_runtime_namespace values generated by
# `aio app use` are also supported; no credential duplication is necessary.
DB_CLIENT_ID=
DB_CLIENT_SECRET=
DB_ORG_ID=
DB_SCOPES=adobeio.abdata.read,adobeio.abdata.write,adobeio.abdata.manage
