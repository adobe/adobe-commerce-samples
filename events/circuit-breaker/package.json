{
  "name": "@adobe/commerce-sample-events-circuit-breaker",
  "description": "Bidirectional Commerce <-> back-office product sync guarded by an infinite-loop breaker.",
  "private": true,
  "version": "1.0.0",
  "dependencies": {
    "@adobe/aio-commerce-lib-app": "^2.0.0",
    "@adobe/aio-commerce-sdk": "^2.0.0",
    "@adobe/aio-lib-core-logging": "^3.0.2",
    "@adobe/aio-lib-state": "^5.3.1"
  },
  "imports": {
    "#app.commerce.config": "./src/commerce-extensibility-1/.generated/app.commerce.config.js",
    "#lib/*": "./src/commerce-extensibility-1/lib/*.js",
    "#product/*": "./src/commerce-extensibility-1/product/utils/*.js"
  },
  "scripts": {
    "postinstall": "npx aio-commerce-lib-app hooks postinstall",
    "code:fix": "ultracite fix",
    "code:check": "ultracite check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:actions": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:actions"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@tsconfig/bases": "^1.0.28",
    "@types/node": "^24.13.4",
    "ts-loader": "^9.6.2",
    "ultracite": "^7.9.4",
    "vitest": "^4.1.10"
  }
}
